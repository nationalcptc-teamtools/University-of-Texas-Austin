{
  "name": "burokrat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run --no-cache web#dev",
    "start": "vp run --no-cache web#start",
    "build": "vp run -r build",
    "test": "vp run -r test",
    "ready": "vp check && vp run -r test && vp run -r build"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
